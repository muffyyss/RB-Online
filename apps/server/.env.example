# Copy to .env and fill in. Never commit the real file.

# Postgres. Bind the database to localhost only; nothing but this server
# should be able to reach it.
DATABASE_URL=postgres://rb_app:CHANGE_ME@127.0.0.1:5432/riftbound

# The server listens on loopback; Caddy terminates TLS and forwards to it.
PORT=3000
HOST=127.0.0.1

NODE_ENV=production
LOG_LEVEL=info

# Registration attempts per IP per window. Invite codes are the only thing
# between a stranger and an account, so guessing them must be slow.
REGISTER_RATE_LIMIT=5
REGISTER_RATE_WINDOW=15 minutes

# Signs access tokens. Anyone with it can impersonate any account, admins
# included. At least 32 characters; generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Login attempts per IP per window.
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW=15 minutes

# Tell a registrant when a username or email is already taken. Fine on a
# private, invite-gated server. Set false if registration ever opens up.
REVEAL_DUPLICATES=true
