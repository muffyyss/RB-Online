{
  "name": "rb-online",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Riftbound Online \u2014 an unofficial, non-commercial fan client for the Riftbound TCG",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "admin": "npm run cli -w @rb/server --",
    "board": "npm run board -w @rb/client",
    "card-art": "node tools/card-art/build-manifest.mjs",
    "card-lint": "npm run start -w @rb/card-lint",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "db:generate": "npm run db:generate -w @rb/server",
    "db:migrate": "npm run db:migrate -w @rb/server",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "rules:check": "python scripts/rules/check_citations.py",
    "rules:extract": "python scripts/rules/extract_rules.py",
    "server": "npm run dev -w @rb/server",
    "sim": "npm run start -w @rb/sim --",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b && tsc -p tsconfig.eslint.json --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.34.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  }
}
