{
  "name": "@rb/card-lint",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Validates every card definition and flags cards without tests.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "start": "node --experimental-strip-types src/index.ts"
  },
  "dependencies": {
    "@rb/cards": "*",
    "@rb/engine": "*"
  }
}
